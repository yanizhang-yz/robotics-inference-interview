PROGRESS_FILE = STATE_DIR / "progress.json"
ARCHIVE_DIR = STATE_DIR / "solutions"
RUN_TIMEOUT = 30
PASS_LINE = "ALL TESTS PASSED"

sys.path.insert(0, str(CPP_DIR))
from cpp_test_support import DEFAULT_FLAGS, find_cpp_compiler  # noqa: E402


# ---------------------------------------------------------------- terminal --

IS_TTY = sys.stdout.isatty()


def _c(code: str, text: str) -> str:
    if not IS_TTY:
        return text
    return f"\033[{code}m{text}\033[0m"


def green(t: str) -> str:
    return _c("32;1", t)


def red(t: str) -> str:
    return _c("31;1", t)


def yellow(t: str) -> str:
    return _c("33", t)


def bold(t: str) -> str:
    return _c("1", t)


def dim(t: str) -> str:
    return _c("2", t)


def cyan(t: str) -> str:
    return _c("36", t)


def hr() -> str:
    return dim("─" * 62)


def render_md(text: str) -> str:
    """Light markdown-to-terminal rendering: bold, inline code, fences."""
    out = []
    in_fence = False
    for line in text.splitlines():
        if line.strip().startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            out.append("    " + cyan(line))
            continue
        line = re.sub(r"\*\*(.+?)\*\*", lambda m: bold(m.group(1)), line)
        line = re.sub(r"`([^`]+)`", lambda m: cyan(m.group(1)), line)
        out.append(line)
    return "\n".join(out).strip("\n")


def prompt_line(message: str) -> str:
    try:
        return input(message)
    except EOFError:
        return "q"


# ------------------------------------------------------------------ lessons --

SECTION_RE = re.compile(r"^## +(.+?) *$", re.MULTILINE)
CHOICE_RE = re.compile(r"^- +([A-C])\) +(.*)$", re.MULTILINE)
PREDICT_META_RE = re.compile(r"<!-- *predict\n(.*?)-->", re.DOTALL)


class LessonFormatError(Exception):
    pass


class Lesson:
    def __init__(self, directory: Path, number: int):
        self.dir = directory
        self.number = number
        self.key = f"{number:02d}"
        readme = directory / "README.md"
        if not readme.exists():
            raise LessonFormatError(f"{directory.name}: missing README.md")
        text = readme.read_text(encoding="utf-8")
        title_match = re.search(r"^# +(.+?) *$", text, re.MULTILINE)
        self.title = title_match.group(1) if title_match else directory.name
        self.sections = self._split_sections(text)
        for required in ("Card", "Predict", "Drill", "Takeaway", "Deep dive"):
            if required not in self.sections:
                raise LessonFormatError(
                    f"{directory.name}: README has no '## {required}' section"
                )
        self._parse_predict(self.sections["Predict"], directory.name)
        self.starter = directory / "starter.cpp"
        self.solution = directory / "solution.cpp"
        for source in (self.starter, self.solution):
            if not source.exists():
                raise LessonFormatError(f"{directory.name}: missing {source.name}")
        self.extra_sources = sorted(
            p
            for p in directory.glob("*.cpp")
            if p.name not in ("starter.cpp", "solution.cpp")
        )

    @staticmethod
    def _split_sections(text: str) -> dict:
        sections = {}
        matches = list(SECTION_RE.finditer(text))
        for i, match in enumerate(matches):
            end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
            sections[match.group(1)] = text[match.end():end].strip()
        return sections

    def _parse_predict(self, section: str, name: str) -> None:
        meta = PREDICT_META_RE.search(section)
        if not meta:
            raise LessonFormatError(f"{name}: Predict has no <!-- predict --> block")
        self.choices = dict(CHOICE_RE.findall(section))
        if sorted(self.choices) != ["A", "B", "C"]:
            raise LessonFormatError(f"{name}: Predict needs exactly choices A, B, C")
        self.question = section[: section.find("- A)")].strip()
        self.answer = ""
        self.whys = {}
        for line in meta.group(1).splitlines():
            line = line.strip()
            if line.startswith("answer:"):
                self.answer = line.split(":", 1)[1].strip().upper()
            match = re.match(r"why-([A-C]): *(.*)", line)
            if match:
                self.whys[match.group(1)] = match.group(2)
        if self.answer not in self.choices:
            raise LessonFormatError(f"{name}: predict answer '{self.answer}' invalid")


def load_lessons() -> list:
    directories = sorted(p for p in LESSONS_DIR.iterdir() if p.is_dir())
    return [Lesson(directory, i + 1) for i, directory in enumerate(directories)]


# ----------------------------------------------------------------- progress --

def load_progress() -> dict:
    if PROGRESS_FILE.exists():
        try:
            return json.loads(PROGRESS_FILE.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    return {"version": 1, "days_played": [], "lessons": {}, "capstone": {}}


def save_progress(progress: dict) -> None:
    STATE_DIR.mkdir(exist_ok=True)
    today = date.today().isoformat()
    if today not in progress["days_played"]:
        progress["days_played"].append(today)
    PROGRESS_FILE.write_text(
        json.dumps(progress, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def lesson_state(progress: dict, key: str) -> dict:
    return progress["lessons"].setdefault(
        key,
        {
            "passed": False,
            "attempts": 0,
            "first_pass": None,
            "predict_first_try": None,
            "review_passes": 0,
        },
    )


def streak(progress: dict) -> int:
    days = {date.fromisoformat(d) for d in progress["days_played"]}
    if not days:
        return 0
    day = date.today()
    if day not in days:
        day = day - timedelta(days=1)
        if day not in days:
            return 0
    count = 0
    while day in days:
        count += 1
        day = day - timedelta(days=1)
    return count


# --------------------------------------------------------------- compiling --

class CheckResult:
    def __init__(self, ok: bool, phase: str, summary: str, detail: str = ""):
        self.ok = ok
        self.phase = phase  # compile | run | output | pass
        self.summary = summary
        self.detail = detail


def _relpath(text: str) -> str:
    return text.replace(str(REPO_ROOT) + "/", "")


def clean_compile_errors(stderr: str) -> str:
    """First real error with a few lines of context, not the whole wall."""
    lines = [_relpath(l) for l in stderr.splitlines()]
    error_indexes = [i for i, l in enumerate(lines) if " error: " in l or l.startswith("error:")]
    if not error_indexes:
        return "\n".join(lines[:8])
    first = error_indexes[0]
    shown = lines[first : first + 6]
    extra = len(error_indexes) - 1
    if extra > 0:
        shown.append(dim(f"…and {extra} more error(s). Fix the first one first."))
    return "\n".join(shown)


def clean_runtime_failure(stdout: str, stderr: str, returncode: int) -> str:
    assert_match = re.search(
        r"Assertion failed: \((.+?)\),.*?file (.+?), line (\d+)", stderr
    )
    parts = []
    if assert_match:
        expression, filename, line = assert_match.groups()
        parts.append(
            f"Assertion failed at {_relpath(filename)}:{line}\n"
            f"  expected: {cyan(expression)}"
        )
    else:
        parts.append(f"Program exited with code {returncode}.")
        tail = [l for l in stderr.splitlines() if l.strip()][-4:]
        if tail:
            parts.append("\n".join(_relpath(l) for l in tail))
    printed = [l for l in stdout.splitlines() if l.strip()][-4:]
    if printed:
        parts.append(dim("program output:\n") + "\n".join(printed))
    return "\n".join(parts)


def check_sources(main_source: Path, extra_sources: list) -> CheckResult:
    compiler = find_cpp_compiler()
    if compiler is None:
        return CheckResult(False, "compile", "No C++ compiler found (need clang++ or g++).")
    with tempfile.TemporaryDirectory() as temp_dir:
        binary = Path(temp_dir) / "drill.out"
        command = [
            compiler,
            *DEFAULT_FLAGS,
            *[str(p) for p in extra_sources],
            str(main_source),
            "-o",
            str(binary),
        ]
        compile_proc = subprocess.run(command, capture_output=True, text=True)
        if compile_proc.returncode != 0:
            return CheckResult(
                False, "compile", "Compile error.", clean_compile_errors(compile_proc.stderr)
            )
        try:
            run_proc = subprocess.run(
                [str(binary)], capture_output=True, text=True, timeout=RUN_TIMEOUT
            )
        except subprocess.TimeoutExpired:
            return CheckResult(
                False, "run", f"Ran longer than {RUN_TIMEOUT}s — infinite loop?"
            )
        if run_proc.returncode != 0:
            return CheckResult(
                False,
                "run",
                "Tests failed.",
                clean_runtime_failure(run_proc.stdout, run_proc.stderr, run_proc.returncode),
            )
        non_empty = [l for l in run_proc.stdout.splitlines() if l.strip()]
        if not non_empty or non_empty[-1].strip() != PASS_LINE:
            return CheckResult(
                False,
                "output",
                f"Program ran but never printed '{PASS_LINE}'.",
                "\n".join(non_empty[-6:]),
            )
    return CheckResult(True, "pass", "All assertions passed.")


def solution_diff(starter: Path, solution: Path) -> str:
    diff = difflib.unified_diff(
        starter.read_text(encoding="utf-8").splitlines(),
        solution.read_text(encoding="utf-8").splitlines(),
        fromfile=f"your {starter.name}",
        tofile=solution.name,
        lineterm="",
    )
    rendered = []
    for line in diff:
        if line.startswith("+") and not line.startswith("+++"):
            rendered.append(green(line))
        elif line.startswith("-") and not line.startswith("---"):
            rendered.append(red(line))
        else:
            rendered.append(dim(line))
    return "\n".join(rendered)


# ---------------------------------------------------------------- rep loop --

def banner(progress: dict, lessons: list, position: str) -> None:
    passed = sum(
        1 for l in lessons if progress["lessons"].get(l.key, {}).get("passed")
    )
    fire = streak(progress)
    streak_part = f"day streak {fire}" if fire else "first day"
    print(hr())
    print(
        f"  {bold('DRILL')} · C++ module 01 · {position}"
        f" · {passed}/{len(lessons)} passed · {streak_part}"
    )
    print(hr())


def run_predict(lesson, state: dict) -> bool:
    """Returns True normally, False if the learner quit."""
    print()
    print(render_md(lesson.question))
    print()
    for letter in ("A", "B", "C"):
        print(f"  {bold(letter)}) {render_md(lesson.choices[letter])}")
    print()
    first_try = True
    while True:
        answer = prompt_line(bold("predict> ")).strip().upper()
        if answer == "Q":
            return False
        if answer not in ("A", "B", "C"):
            print(dim("  answer A, B, or C (or q to quit)"))
            continue
        why = lesson.whys.get(answer, "")
        if answer == lesson.answer:
            print(f"  {green('✓ correct.')} {render_md(why)}")
            if state.get("predict_first_try") is None:
                state["predict_first_try"] = first_try
            return True
        print(f"  {red('✗ not this one.')} {render_md(why)}")
        first_try = False


def watched_mtime(paths: list) -> float:
    newest = 0.0
    for path in paths:
        try:
            newest = max(newest, path.stat().st_mtime)
        except OSError:
            pass
    return newest


def read_command(timeout: float) -> str:
    """Read a command line from stdin during watch mode.

    On a tty this is non-blocking (select with a timeout) so file watching
    keeps polling. On a pipe (scripts, tests) it blocks on readline —
    select would deadlock against Python's stdin buffering — and treats
    EOF as quit so piped sessions always terminate.
    """
    if sys.stdin.isatty():
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if not ready:
            return ""
    line = sys.stdin.readline()
    if line == "":  # EOF
        return "q"
    return line.strip().lower()


def run_drill_watch(
    progress: dict,
    state: dict,
    check,
    deep_dive: str,
    starter: Path,
    solution,
    extra_watch: list = (),
) -> bool:
    """Watch-save-check loop. Returns True on pass, False if learner quit."""
    watch_list = [starter, *extra_watch]
    print()
    print(f"  edit  {bold(str(starter.relative_to(REPO_ROOT)))}")
    print(dim("  every save re-runs the tests · h⏎ hint · s⏎ solution · q⏎ quit · r⏎ re-check"))
    print()
    print(yellow("  … waiting for your first save"))
    failures = 0
    deep_dive_shown = False
    last_mtime = watched_mtime(watch_list)
    while True:
        command = read_command(0.4)
        if command == "q":
            print(dim("  progress saved — resume anytime with ./drill"))
            return False
        if command == "h":
            print()
            print(render_md(deep_dive))
            deep_dive_shown = True
            continue
        if command == "s" and solution is not None:
            print()
            print(solution_diff(starter, solution))
            continue
        current = watched_mtime(watch_list)
        if current > last_mtime:
            pass  # a save happened — check it
        elif command == "r":
            pass  # explicit re-check without a save
        else:
            if command:
                print(dim("  commands: h⏎ hint · s⏎ solution · r⏎ re-check · q⏎ quit"))
            continue
        last_mtime = current
        time.sleep(0.15)  # let the editor finish writing
        print(dim(f"  [{datetime.now().strftime('%H:%M:%S')}] checking…"))
        result = check()
        state["attempts"] += 1
        save_progress(progress)
        if result.ok:
            print(f"  {green('● PASS')}  {result.summary}")
            return True
        failures += 1
        print(f"  {red('● FAIL')}  {result.summary}")
        if result.detail:
            print(re.sub(r"^", "  ", result.detail, flags=re.MULTILINE))
        if failures == 2 and not deep_dive_shown:
            print()
            print(dim("  a fuller explanation, since this one is putting up a fight:"))
            print(render_md(deep_dive))
            deep_dive_shown = True
        elif failures >= 3 and solution is not None:
            print(dim("  stuck? s⏎ shows the solution diff — your call."))
        print()


def serve_lesson(lesson, progress: dict, lessons: list, review: bool = False) -> str:
    """Serve one full rep. Returns 'passed' | 'quit'."""
    state = lesson_state(progress, lesson.key)
    label = "review" if review else f"lesson {lesson.number}/{len(lessons)}"
    banner(progress, lessons, label)
    print()
    print(f"  {bold(lesson.title)}")
    print()
    print(render_md(lesson.sections["Card"]))
    print()
    if not run_predict(lesson, state):
        save_progress(progress)
        return "quit"
    save_progress(progress)
    print()
    print(render_md(lesson.sections["Drill"]))
    passed = run_drill_watch(
        progress,
        state,
        lambda: check_sources(lesson.starter, lesson.extra_sources),
        lesson.sections["Deep dive"],
        lesson.starter,
        lesson.solution,
        extra_watch=lesson.extra_sources,
    )
    if not passed:
        return "quit"
    if review:
        state["review_passes"] += 1
    elif not state["passed"]:
        state["passed"] = True
        state["first_pass"] = date.today().isoformat()
    save_progress(progress)
    print()
    print(render_md(lesson.sections["Takeaway"]))
    print()
    return "passed"


# ---------------------------------------------------------------- capstone --

STAGE_HEADER_RE = re.compile(r"^## +Stage (\d+)[^\n]*$", re.MULTILINE)


class Capstone:
    def __init__(self):
        readme = CAPSTONE_DIR / "README.md"
        if not readme.exists():
            raise LessonFormatError("capstone/README.md is missing")
        text = readme.read_text(encoding="utf-8")
        self.sections = Lesson._split_sections(text)
        self.stage_names = {}
        for match in STAGE_HEADER_RE.finditer(text):
            number = int(match.group(1))
            self.stage_names[number] = match.group(0).lstrip("# ").strip()
        self.stages = sorted(self.stage_names)
        self.starter = CAPSTONE_DIR / "starter.cpp"
        self.solution = CAPSTONE_DIR / "solution.cpp"
        self.fixtures = CAPSTONE_DIR / "fixtures"

    def stage_section(self, number: int) -> str:
        for name, body in self.sections.items():
            if name.startswith(f"Stage {number}"):
                return f"{bold(name)}\n\n{render_md(body)}"
        return ""

    def check_stage(self, source: Path, stage: int) -> CheckResult:
        compiler = find_cpp_compiler()
        if compiler is None:
            return CheckResult(False, "compile", "No C++ compiler found.")
        input_file = self.fixtures / f"stage{stage}_input.txt"
        expected_file = self.fixtures / f"stage{stage}_expected.txt"
        with tempfile.TemporaryDirectory() as temp_dir:
            binary = Path(temp_dir) / "capstone.out"
            command = [compiler, *DEFAULT_FLAGS, str(source), "-o", str(binary)]
            compile_proc = subprocess.run(command, capture_output=True, text=True)
            if compile_proc.returncode != 0:
                return CheckResult(
                    False, "compile", "Compile error.",
                    clean_compile_errors(compile_proc.stderr),
                )
            try:
                run_proc = subprocess.run(
                    [str(binary), str(stage)],
                    input=input_file.read_text(encoding="utf-8"),
                    capture_output=True,
                    text=True,
                    timeout=RUN_TIMEOUT,
                )
            except subprocess.TimeoutExpired:
                return CheckResult(False, "run", f"Stage {stage} ran longer than {RUN_TIMEOUT}s.")
            if run_proc.returncode != 0:
                return CheckResult(
                    False, "run", f"Stage {stage} exited with {run_proc.returncode}.",
                    clean_runtime_failure(run_proc.stdout, run_proc.stderr, run_proc.returncode),
                )
            actual = run_proc.stdout.rstrip("\n")
            expected = expected_file.read_text(encoding="utf-8").rstrip("\n")
            if actual != expected:
                return CheckResult(
                    False, "output", f"Stage {stage} output differs from expected.",
                    output_diff(expected, actual),
                )
        return CheckResult(True, "pass", f"Stage {stage} complete.")


def output_diff(expected: str, actual: str) -> str:
    diff = list(
        difflib.unified_diff(
            expected.splitlines(), actual.splitlines(),
            fromfile="expected", tofile="yours", lineterm="", n=1,
        )
    )
    rendered = []
    for line in diff[:14]:
        if line.startswith("+") and not line.startswith("+++"):
            rendered.append(red(line))  # what the learner printed
        elif line.startswith("-") and not line.startswith("---"):
            rendered.append(green(line))  # what was expected
        else:
            rendered.append(dim(line))
    if len(diff) > 14:
        rendered.append(dim(f"…{len(diff) - 14} more diff lines"))
    return "\n".join(rendered)


def serve_capstone(progress: dict, lessons: list) -> str:
    capstone = Capstone()
    state = progress.setdefault("capstone", {})
    state.setdefault("stage", 1)
    state.setdefault("attempts", 0)
    state.setdefault("passed", False)
    passed_count = sum(
        1 for l in lessons if progress["lessons"].get(l.key, {}).get("passed")
    )
    if passed_count < len(lessons) and not state["passed"]:
        print(
            yellow(
                f"  heads up: {passed_count}/{len(lessons)} lessons passed — "
                "the capstone assumes all of them."
            )
        )
        if prompt_line("  play it anyway? [y/N] ").strip().lower() != "y":
            return "quit"
    banner(progress, lessons, "capstone")
    print()
    print(render_md(capstone.sections.get("Card", "")))
    total = len(capstone.stages)

    while state["stage"] <= total:
        stage = state["stage"]
        print()
        print(hr())
        print(f"  {bold(f'STAGE {stage}/{total} UNLOCKED')}")
        print()
        print(capstone.stage_section(stage))
        print()

        def check_current() -> CheckResult:
            for done_stage in range(1, stage):
                result = capstone.check_stage(capstone.starter, done_stage)
                if not result.ok:
                    result.summary = f"regression: {result.summary}"
                    return result
            return capstone.check_stage(capstone.starter, stage)

        passed = run_drill_watch(
            progress,
            state,
            check_current,
            capstone.stage_section(stage),
            capstone.starter,
            capstone.solution,
        )
        if not passed:
            return "quit"
        state["stage"] = stage + 1
        save_progress(progress)
        print(green(f"  ● stage {stage} down."))

    state["passed"] = True
    save_progress(progress)
    print()
    print(green(bold("  ★ MODULE 01 COMPLETE — you built the whole thing.")))
    print(render_md(capstone.sections.get("Takeaway", "")))
    return "passed"


# ---------------------------------------------------------------- commands --

def next_incomplete(progress: dict, lessons: list):
    for lesson in lessons:
        if not progress["lessons"].get(lesson.key, {}).get("passed"):
            return lesson
    return None


def cmd_play(target, progress: dict, lessons: list) -> int:
    rail = target is None
    while True:
        if rail:
            lesson = next_incomplete(progress, lessons)
            if lesson is None:
                if progress.get("capstone", {}).get("passed"):
                    print(green("Module 01 is fully complete — try ./drill review."))
                else:
                    serve_capstone(progress, lessons)
                return 0
        else:
            lesson = target
        outcome = serve_lesson(lesson, progress, lessons)
        if outcome != "passed":
            return 0
        if not rail:
            print(dim("passed — plain ./drill continues the rail."))
            return 0
        remaining = next_incomplete(progress, lessons)
        prompt = "next lesson" if remaining else "the capstone"
        if prompt_line(bold(f"enter for {prompt}, q to stop> ")).strip().lower() == "q":
            return 0


def cmd_review(progress: dict, lessons: list) -> int:
    import random

    passed = [
        l for l in lessons if progress["lessons"].get(l.key, {}).get("passed")
    ]
    if not passed:
        print("Nothing to review yet — pass a lesson first: ./drill")
        return 1
    chosen = random.sample(passed, min(3, len(passed)))
    chosen.sort(key=lambda l: l.number)
    names = ", ".join(l.dir.name for l in chosen)
    print(f"Review resets these starters to a blank slate: {bold(names)}")
    print(f"Your current files are archived in {ARCHIVE_DIR.relative_to(REPO_ROOT)}/ first.")
    if prompt_line("continue? [y/N] ").strip().lower() != "y":
        return 0
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    for lesson in chosen:
        archive = ARCHIVE_DIR / f"{lesson.dir.name}_{stamp}_starter.cpp"
        archive.write_text(lesson.starter.read_text(encoding="utf-8"), encoding="utf-8")
        relative = lesson.starter.relative_to(REPO_ROOT).as_posix()
        pristine = subprocess.run(
            ["git", "-C", str(REPO_ROOT), "show", f"HEAD:{relative}"],
            capture_output=True, text=True,
        )
        if pristine.returncode != 0:
            print(red(f"  cannot reset {relative} from git; skipping"))
            continue
        lesson.starter.write_text(pristine.stdout, encoding="utf-8")
    for lesson in chosen:
        if serve_lesson(lesson, progress, lessons, review=True) != "passed":
            return 0
    print(green("review complete — that's how you keep it."))
    return 0


def cmd_status(progress: dict, lessons: list) -> int:
    banner(progress, lessons, "status")
    firsts = []
    for lesson in lessons:
        state = progress["lessons"].get(lesson.key, {})
        if state.get("passed"):
            mark, note = green("✓"), dim(f"passed {state.get('first_pass', '')}")
            if state.get("review_passes"):
                note += dim(f" · reviewed ×{state['review_passes']}")
        elif state.get("attempts"):
            mark, note = yellow("…"), dim(f"{state['attempts']} attempts so far")
        else:
            mark, note = dim("·"), ""
        print(f"  {mark} {lesson.title}  {note}")
        if state.get("predict_first_try") is not None:
            firsts.append(state["predict_first_try"])
    capstone_state = progress.get("capstone", {})
    if capstone_state.get("passed"):
        print(f"  {green('★')} Capstone — complete")
    elif capstone_state.get("attempts"):
        print(f"  {yellow('…')} Capstone — stage {capstone_state.get('stage', 1)}")
    else:
        print(f"  {dim('·')} Capstone — locked in spirit, open in practice")
    if firsts:
        print()
        print(dim(f"  predictions right first try: {sum(firsts)}/{len(firsts)}"))
    return 0


def cmd_doctor(lessons_or_error) -> int:
    failures = []
    compiler = find_cpp_compiler()
    print(f"compiler: {compiler or red('MISSING — install clang++ or g++')}")
    if compiler is None:
        failures.append("compiler")
    if isinstance(lessons_or_error, Exception):
        print(red(f"lesson format: {lessons_or_error}"))
        return 1
    lessons = lessons_or_error
    for lesson in lessons:
        result = check_sources(lesson.solution, lesson.extra_sources)
        status = green("ok") if result.ok else red(f"FAIL ({result.summary})")
        print(f"  {lesson.dir.name}: parse ok, solution {status}")
        if not result.ok:
            failures.append(lesson.dir.name)
            if result.detail:
                print(re.sub(r"^", "    ", result.detail, flags=re.MULTILINE))
    try:
        capstone = Capstone()
        for stage in capstone.stages:
            result = capstone.check_stage(capstone.solution, stage)
            status = green("ok") if result.ok else red(f"FAIL ({result.summary})")
            print(f"  capstone stage {stage}: solution {status}")
            if not result.ok:
                failures.append(f"capstone{stage}")
                if result.detail:
                    print(re.sub(r"^", "    ", result.detail, flags=re.MULTILINE))
    except LessonFormatError as error:
        print(red(f"  capstone: {error}"))
        failures.append("capstone")
    print()
    if failures:
        print(red(f"doctor: {len(failures)} problem(s)"))
        return 1
    print(green("doctor: everything checks out"))
    return 0


def cmd_check(target, lessons: list) -> int:
    """Single non-interactive check — for scripts and CI."""
    if target == "capstone":
        capstone = Capstone()
        for stage in capstone.stages:
            result = capstone.check_stage(capstone.starter, stage)
            print(f"stage {stage}: {'PASS' if result.ok else 'FAIL — ' + result.summary}")
            if not result.ok:
                if result.detail:
                    print(result.detail)
                return 1
        return 0
    result = check_sources(target.starter, target.extra_sources)
    print(f"{target.dir.name}: {'PASS' if result.ok else 'FAIL — ' + result.summary}")
    if result.detail:
        print(result.detail)
    return 0 if result.ok else 1


def main(argv: list) -> int:
    parser = argparse.ArgumentParser(
        prog="drill", description=__doc__, add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "target", nargs="?", default=None,
        help="lesson number (1-10), 'capstone', 'review', 'status', or 'doctor'",
    )
    parser.add_argument("--check", action="store_true", help="one non-interactive check, exit 0/1")
    parser.add_argument("--show-solution", action="store_true", help="print the solution diff and exit")
    args = parser.parse_args(argv)

    try:
        lessons = load_lessons()
    except LessonFormatError as error:
        if args.target == "doctor":
            return cmd_doctor(error)
        print(red(f"lesson format problem: {error}"))
        print("run ./drill doctor for a full report")
        return 1

    progress = load_progress()

    if args.target == "doctor":
        return cmd_doctor(lessons)
    if args.target == "status":
        return cmd_status(progress, lessons)
    if args.target == "review":
        return cmd_review(progress, lessons)

    target = None
    if args.target == "capstone":
        target = "capstone"
    elif args.target is not None:
        try:
            number = int(args.target)
            if not 1 <= number <= len(lessons):
                raise ValueError
            target = lessons[number - 1]
        except ValueError:
            parser.error(f"'{args.target}' is not a lesson number (1-{len(lessons)}), "
                         "'capstone', 'review', 'status', or 'doctor'")

    if args.show_solution:
        if target in (None, "capstone"):
            capstone = Capstone()
            print(solution_diff(capstone.starter, capstone.solution))
        else:
            print(solution_diff(target.starter, target.solution))
        return 0
    if args.check:
        if target is None:
            parser.error("--check needs a lesson number or 'capstone'")
        return cmd_check(target, lessons)

    try:
        if target == "capstone":
            serve_capstone(progress, lessons)
            return 0
        return cmd_play(target, progress, lessons)
    except KeyboardInterrupt:
        print()
        print(dim("progress saved — resume anytime with ./drill"))
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
