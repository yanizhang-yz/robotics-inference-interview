CPP_DIR = REPO_ROOT / "ramp_up" / "cpp"
MODULE_DIR = CPP_DIR / "01_stl_containers"
LESSONS_DIR = MODULE_DIR / "lessons"
CAPSTONE_DIR = MODULE_DIR / "capstone"
